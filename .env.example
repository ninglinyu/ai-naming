# 复制为 .env（或 .env.local）后填入真实值；.env 已被 .gitignore 忽略，不会上传 GitHub
# 线上部署时，在 Vercel 控制台 Settings → Environment Variables 里配同名变量

# ---- Supabase ----
SUPABASE_URL=https://zhdqyidijojadrwiklna.supabase.co
# 服务端专用密钥，拥有写权限，绝不出现在前端代码里
SUPABASE_SERVICE_ROLE_KEY=
# 如果暂时只有匿名密钥，也可以填这一项（代码会自动回退使用）
SUPABASE_ANON_KEY=

# ---- 模型：四家任选，配了谁就能在页面上下拉选谁 ----
# 豆包 · 火山方舟  https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=
# DOUBAO_MODEL=doubao-seed-1-6-250615

# DeepSeek  https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# 通义千问 DashScope（必须用 compatible-mode 地址）
QWEN_API_KEY=
# QWEN_MODEL=qwen-plus

# Kimi 月之暗面  https://api.moonshot.cn/v1
KIMI_API_KEY=
# KIMI_MODEL=moonshot-v1-8k

# 页面上默认选中的模型（不给就选第一个已配置的）
# DEFAULT_MODEL=doubao
